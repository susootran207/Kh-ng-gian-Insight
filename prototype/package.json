{
  "name": "khong-gian-noi-tam-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run test:content",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:production": "playwright test -c playwright.production.config.ts",
    "test:content": "node --experimental-strip-types scripts/check-publication.mts",
    "test:f0": "node --experimental-strip-types --test --test-isolation=none tests/content-contract.test.mts",
    "content:manifest": "node --experimental-strip-types scripts/generate-manifest.mts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
